#!/usr/bin/env node
// zcode-tui launcher — the TUI runtime is Bun-first (bun:sqlite, OpenTUI bun
// entries). Prefers the repo's compiled binary, then bun, then fails honestly.
import { existsSync, readFileSync } from "node:fs";
import { spawn } from "node:child_process";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const pkg = dirname(fileURLToPath(import.meta.url)) + "/..";
const args = process.argv.slice(2);

// The provisioner's health check runs `--version` and requires exit 0 —
// answer from package.json BEFORE anything boots. A run without a TTY never
// boots the full-screen UI either: it would hang the check.
if (args.includes("--version") || args.includes("-V") || !process.stdin.isTTY) {
  const { version } = JSON.parse(readFileSync(join(pkg, "package.json"), "utf8"));
  console.log(`zcode-tui ${version}`);
  if (args.includes("--version") || args.includes("-V")) process.exit(0);
}
// Headless worker verbs: no TTY needed — run (one session, owner directive
// 2026-10-21), queue (fleet worker queue, 2026-10-22), idle (ZCode idle-time
// tasks client), autoclaw (AutoClaw plan driver, 2026-10-23), install (fleet
// plan-harness installer, 2.0.0 2026-10-25). All execute under bun straight
// from the repo tree.
const headlessVerbs = { run: "run.ts", queue: "queue.ts", idle: "idle.ts", plans: "plans.ts", autoclaw: "autoclaw.ts", install: "install.ts", usage: "usage.ts" };
if (headlessVerbs[args[0]]) {
  const bunCandidates = [
    process.env.BUN_INSTALL && join(process.env.BUN_INSTALL, "bin", "bun"),
    join(homedir(), ".bun", "bin", "bun"),
    "bun",
  ].filter(Boolean);
  const bun = bunCandidates.find((c) => c === "bun" || existsSync(c));
  if (!bun) {
    console.error(`zcode-tui ${args[0]} needs bun (https://bun.sh).`);
    process.exit(1);
  }
  const p = spawn(bun, [join(pkg, "src/bin", headlessVerbs[args[0]]), ...args.slice(1)], { stdio: "inherit" });
  p.on("exit", (c) => process.exit(c ?? 0));
}
if (args.includes("--help") || args.includes("-h")) {
  console.log("zcode-tui - a TUI for the ZCode runtime (GPL-3.0-or-later)");
  console.log("usage: zcode-tui [--resume <sessionId>] [--model <modelId>]");
  console.log("       zcode-tui run --content-file BRIEF.md --workspace DIR [--model ID]");
  console.log("       zcode-tui queue enqueue --prompt-file F --workspace DIR --route R");
  console.log("       zcode-tui queue list|ls|status|serve   (fleet worker queue)");
  console.log("       zcode-tui idle list|create          (ZCode idle-time tasks)");
  console.log("       zcode-tui autoclaw <setup|proxy|credential|doctor|run>   (AutoClaw plan)");
  console.log("       zcode-tui usage [--reset-opportunity]    (live plan windows + reset tokens)");
  console.log("       zcode-tui install <doctor|zcode|autoclaw|autoclaw-headless>");
  console.log("requires bun (https://bun.sh) or a compiled dist/zcode-tui binary");
  process.exit(0);
}
// A TTY-less bare invocation must not boot the full-screen UI (it would hang
// the caller). Print the identity and exit honestly; `run` was handled above.
if (!process.stdin.isTTY && !args.includes("--version") && !args.includes("-V")) {
  console.log("zcode-tui: no TTY - use `zcode-tui run --content-file ... --workspace ...` for headless work.");
  process.exit(0);
}

const bin = join(pkg, "dist/zcode-tui");
if (existsSync(bin)) {
  const p = spawn(bin, args, { stdio: "inherit" });
  p.on("exit", (c) => process.exit(c ?? 0));
} else {
  const bunCandidates = [
    process.env.BUN_INSTALL && join(process.env.BUN_INSTALL, "bin", process.platform === "win32" ? "bun.exe" : "bun"),
    join(homedir(), ".bun", "bin", process.platform === "win32" ? "bun.exe" : "bun"),
    process.platform === "win32" ? join(homedir(), "AppData", "Local", "bun", "bin", "bun.exe") : "/usr/local/bin/bun",
    "bun",
  ].filter(Boolean);
  const bun = bunCandidates.find((candidate) => candidate === "bun" || existsSync(candidate));
  if (!bun) {
    console.error("zcode-tui needs bun (https://bun.sh) or a compiled dist/zcode-tui binary.");
    process.exit(1);
  }
  const p = spawn(bun, [join(pkg, "src/tui/main.tsx"), ...args], { stdio: "inherit" });
  p.on("exit", (c) => process.exit(c ?? 0));
}
