    "tui:drive": "bun run src/tui/headless-drive.tsx"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.2.8"
  }
